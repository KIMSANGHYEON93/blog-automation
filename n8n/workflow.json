{
  "name": "Blog Automation Pipeline A — Content Generation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 1 * * *" }]
        }
      },
      "id": "node-1-schedule",
      "name": "Schedule Trigger (01:00 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "sheetId": { "value": "={{ $env.SHEET_ID }}" },
        "range": "A:S",
        "options": {
          "filters": [
            { "column": "상태", "value": "발행완료" },
            { "column": "상태", "value": "발행대기" }
          ],
          "combineFilters": "OR"
        }
      },
      "id": "node-dup-1-sheets-published",
      "name": "Sheets Read (Published Keywords)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GOOGLE_CREDS_ID" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Reduce to Trigger — Published Keywords 다수 행을 1개 트리거로 축소\n// 다음 노드에서 불필요한 N회 API 호출 방지\nreturn [{ json: { _trigger: true } }];"
      },
      "id": "node-dup-reduce",
      "name": "Reduce to Trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [570, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "sheetId": { "value": "={{ $env.SHEET_ID }}" },
        "range": "A:S",
        "options": {
          "filters": {
            "column": "상태",
            "value": "대기"
          }
        }
      },
      "id": "node-2-sheets-read",
      "name": "Sheets Read (Status=대기)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [680, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GOOGLE_CREDS_ID" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// check_duplicate.js — 기존 발행글과 키워드 유사도 비교\n// n8n/code_nodes/check_duplicate.js 내용을 여기에 복사"
      },
      "id": "node-dup-2-check",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{ $json.duplicate_check.is_duplicate }}", "value2": false }
          ]
        }
      },
      "id": "node-dup-3-if",
      "name": "IF Not Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "sheetId": { "value": "={{ $env.SHEET_ID }}" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "상태": "중복스킵",
            "에러메시지": "={{ '중복 키워드: ' + $json.duplicate_check.duplicate_of + ' (유사도: ' + ($json.duplicate_check.max_overlap * 100) + '%)' }}"
          },
          "matchingColumns": ["키워드"]
        }
      },
      "id": "node-dup-4-sheets-skip",
      "name": "Sheets Update (중복스킵)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1120, 500],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GOOGLE_CREDS_ID" } }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://serpapi.com/search.json",
        "qs": {
          "q": "={{ $json.keyword }}",
          "location": "South Korea",
          "hl": "ko",
          "gl": "kr",
          "num": "10",
          "api_key": "={{ $env.SERPAPI_KEY }}"
        }
      },
      "id": "node-3-serpapi",
      "name": "SerpAPI Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "jsCode": "// route_prompt.js — 프롬프트 유형 분기\n// n8n/code_nodes/route_prompt.js 내용을 여기에 복사"
      },
      "id": "node-4-route-prompt",
      "name": "Route Prompt (A/B/C)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendHeaders": true,
        "sendBody": true
      },
      "id": "node-5-gemini-flash",
      "name": "Gemini Flash (Content Gen)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "jsCode": "// parse_json.js — JSON 파싱 + 필드 검증\n// n8n/code_nodes/parse_json.js 내용을 여기에 복사"
      },
      "id": "node-6-parse-json",
      "name": "Parse JSON Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "jsCode": "// validate_urls.js — URL 정규식 검증\n// n8n/code_nodes/validate_urls.js 내용을 여기에 복사"
      },
      "id": "node-7a-url-validate",
      "name": "URL Validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 200]
    },
    {
      "parameters": {
        "jsCode": "// lint_code_blocks.js — 코드 블록 검사\n// n8n/code_nodes/lint_code_blocks.js 내용을 여기에 복사"
      },
      "id": "node-7b-code-lint",
      "name": "Code Block Lint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendHeaders": true,
        "sendBody": true
      },
      "id": "node-7c-gemini-verify",
      "name": "Gemini Verification (temp=0)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2440, 300]
    },
    {
      "parameters": {
        "jsCode": "// parse_verification.js — 검증 결과 파싱\n// n8n/code_nodes/parse_verification.js 내용을 여기에 복사"
      },
      "id": "node-8-parse-verify",
      "name": "Parse Verification Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{ $json.verification.passed }}", "value2": true }
          ]
        }
      },
      "id": "node-9-if-passed",
      "name": "Verification Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2880, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "sheetId": { "value": "={{ $env.SHEET_ID }}" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "상태": "발행대기",
            "제목": "={{ $json.title }}",
            "메타설명": "={{ $json.meta_description }}",
            "URL슬러그": "={{ $json.url_slug || '' }}",
            "본문마크다운": "={{ $json.content }}"
          }
        }
      },
      "id": "node-10a-sheets-pass",
      "name": "Sheets Update (발행대기)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [3100, 200],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GOOGLE_CREDS_ID" } }
    },
    {
      "parameters": {
        "operation": "update",
        "sheetId": { "value": "={{ $env.SHEET_ID }}" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "상태": "검수필요",
            "에러메시지": "={{ $json.verification.reason || '검증 실패' }}"
          }
        }
      },
      "id": "node-10b-sheets-fail",
      "name": "Sheets Update (검수필요)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [3100, 400],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GOOGLE_CREDS_ID" } }
    }
  ],
  "connections": {
    "Schedule Trigger (01:00 AM)": { "main": [[{ "node": "Sheets Read (Published Keywords)", "type": "main", "index": 0 }]] },
    "Sheets Read (Published Keywords)": { "main": [[{ "node": "Reduce to Trigger", "type": "main", "index": 0 }]] },
    "Reduce to Trigger": { "main": [[{ "node": "Sheets Read (Status=대기)", "type": "main", "index": 0 }]] },
    "Sheets Read (Status=대기)": { "main": [[{ "node": "Check Duplicate", "type": "main", "index": 0 }]] },
    "Check Duplicate": { "main": [[{ "node": "IF Not Duplicate?", "type": "main", "index": 0 }]] },
    "IF Not Duplicate?": {
      "main": [
        [{ "node": "SerpAPI Search", "type": "main", "index": 0 }],
        [{ "node": "Sheets Update (중복스킵)", "type": "main", "index": 0 }]
      ]
    },
    "SerpAPI Search": { "main": [[{ "node": "Route Prompt (A/B/C)", "type": "main", "index": 0 }]] },
    "Route Prompt (A/B/C)": { "main": [[{ "node": "Gemini Flash (Content Gen)", "type": "main", "index": 0 }]] },
    "Gemini Flash (Content Gen)": { "main": [[{ "node": "Parse JSON Response", "type": "main", "index": 0 }]] },
    "Parse JSON Response": { "main": [[
      { "node": "URL Validation", "type": "main", "index": 0 },
      { "node": "Code Block Lint", "type": "main", "index": 0 }
    ]] },
    "URL Validation": { "main": [[{ "node": "Gemini Verification (temp=0)", "type": "main", "index": 0 }]] },
    "Code Block Lint": { "main": [[{ "node": "Gemini Verification (temp=0)", "type": "main", "index": 0 }]] },
    "Gemini Verification (temp=0)": { "main": [[{ "node": "Parse Verification Result", "type": "main", "index": 0 }]] },
    "Parse Verification Result": { "main": [[{ "node": "Verification Passed?", "type": "main", "index": 0 }]] },
    "Verification Passed?": {
      "main": [
        [{ "node": "Sheets Update (발행대기)", "type": "main", "index": 0 }],
        [{ "node": "Sheets Update (검수필요)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Seoul"
  }
}
