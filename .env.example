KAKAO_ID=example@kakao.com
KAKAO_PW=your_password
TISTORY_BLOG=your-blog
GOOGLE_CREDS=credentials.json
SHEET_NAME=keyword_calendar_v2
SHEET_ID=
MAX_POSTS=5
HEADLESS=true
MIN_DELAY=300
MAX_DELAY=900
LLM_PROVIDER=

# SEO API Keys
SERPAPI_KEY=
PAGESPEED_API_KEY=

# AI Image Generation (Pipeline C: 썸네일 생성)
# Pollinations (무료, 기본값): enter.pollinations.ai 가입 후 API 키 발급
POLLINATIONS_API_KEY=
# DALL-E 3 (유료, $0.04/장): OPENAI_API_KEY 설정 시 자동 전환
OPENAI_API_KEY=

# Site profile (카테고리 매핑 + 키워드 분류)
SITE_PROFILE=site_profile.json

# Feature flags
CWV_CHECK=true
RETRY_FAILED=false

# AdSense 필수 페이지 발행용 (--publish-pages)
CONTACT_EMAIL=your-email@example.com
OWNER_NAME=블로그운영자

# Sitemap 출력 경로
SITEMAP_OUTPUT=sitemap.xml

# 알림 (Slack 또는 Telegram 중 하나만 설정)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firecrawl API (공식문서 크롤링, Pipeline A)
FIRECRAWL_API_KEY=

# Google Ads Keyword Planner API (키워드 메트릭 수집, Pipeline A 보조)
# Manager 계정의 Developer Token (API Center에서 발급, Explorer 레벨 자동 승인)
GOOGLE_ADS_DEVELOPER_TOKEN=
# Google Ads Customer ID (하이픈 제거, 예: 1234567890)
GOOGLE_ADS_CUSTOMER_ID=
# Manager 계정 ID (MCC 사용 시 필수, 하이픈 제거)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# 서비스 계정 인증 (권장: JWT → access_token 자동 교환)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# 정적 Access Token (테스트/개발용, 서비스 계정 미설정 시 fallback)
GOOGLE_ADS_ACCESS_TOKEN=

# n8n 모니터링 (check_status.sh / check_last_run.sh에서 사용)
N8N_API_KEY=
