<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blog-automation.wake-scheduler</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kimsanghyeon/Documents/GitHub/Core Web Vitals/blog-automation/scripts/schedule_wake.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/blog-automation-wake.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/blog-automation-wake.log</string>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
